# SoSoValue Terminal API key (required)
SOSOVALUE_API_KEY=

# LLM API key (required — set at least one)
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# LLM provider & model (optional)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# Data sources to analyze (comma-separated, optional)
SOURCES=price_action,news_event,macro_event,index_divergence,sector_rotation,etf_flow

# Currencies to monitor (comma-separated, optional)
MONITORED_CURRENCIES=bitcoin,ethereum,solana

# Minimum confidence threshold (optional)
MIN_CONFIDENCE=60

# ---------------------------------------------------------------------------
# Upstash Redis — required for Vercel deployment (persistent storage)
# Create a free database at https://console.upstash.com
# Copy the REST URL and token from the database dashboard
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
